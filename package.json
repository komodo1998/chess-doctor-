{
  "name": "chess-doctor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chess Doctor — AI-powered chess diagnostics built on Lichess open-source components (chessground board, Stockfish WASM engine)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "esbuild scripts/bugcheck.ts --bundle --format=esm --platform=node --outfile=scripts/.bugcheck-bundle.mjs --log-level=warning && node scripts/.bugcheck-bundle.mjs",
    "verify-samples": "node scripts/verify-samples.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stockfish": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
